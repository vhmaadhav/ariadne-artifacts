+# Per-hypothesis evidence for offline calibration (ariadne E4). Only used when
+# return_hypotheses=True; the decision path never reads these.
+LOG_NET_TOPK = 10          # off-peak network response maxima kept per hypothesis
+LOG_ZNCC_TOPK = 50         # off-peak native ZNCC maxima kept per hypothesis
+LOG_ZNCC_EXCLUDE = 16.0    # px disc around the winner excluded from the ZNCC decoy list
+
+
+def offpeak_cells(prob: np.ndarray, cell: tuple[int, int], k: int,
+                  min_sep: float = 2.0) -> list[tuple[int, int, float]]:
+    """Top-k local maxima of a response map farther than `min_sep` cells from `cell`."""
+    out: list[tuple[int, int, float]] = []
+    for i, j, v in find_peaks(prob, max_peaks=k + 32):
+        if np.hypot(i - cell[0], j - cell[1]) > min_sep:
+            out.append((i, j, v))
+            if len(out) == k:
+                break
+    return out
+
+
+def zncc_surface_peaks(search_std: np.ndarray, template_std: np.ndarray,
+                       winner_xy: tuple[float, float], k: int,
+                       exclude: float) -> tuple[list[list[float]], int, int]:
+    """Native ZNCC surface over the whole search frame, as decoy evidence.
+
+    Returns (top-k off-disc local maxima as [value, x, y], number of off-disc
+    local maxima, number of local maxima in total). Centres use the convention
+    of refine_zncc: window top-left plus template half-size, pixel-edge frame.
+    """
+    th, tw = template_std.shape
+    surf = cv2.matchTemplate(search_std.astype(np.float32),
+                             template_std.astype(np.float32), cv2.TM_CCOEFF_NORMED)
+    surf = np.nan_to_num(surf, nan=-1.0, neginf=-1.0).astype(np.float32)
+    peaks = find_peaks(surf, max_peaks=10 ** 9)
+    wx, wy = winner_xy
+    off: list[list[float]] = []
+    for i, j, v in peaks:
+        x, y = j + tw / 2.0, i + th / 2.0
+        if np.hypot(x - wx, y - wy) > exclude:
+            off.append([float(v), float(x), float(y)])
+    return off[:k], len(off), len(peaks)
+
+
